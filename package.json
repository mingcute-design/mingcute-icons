{
  "name": "mingcute-icons",
  "version": "3.0.2",
  "private": true,
  "description": "Public workspace for building and maintaining free MingCute icon packages.",
  "keywords": [
    "svg-icons",
    "vector-icons",
    "icon-library"
  ],
  "license": "Apache-2.0",
  "author": "MingCute Design",
  "homepage": "https://www.mingcute.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mingcute-design/mingcute-icons.git"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "check": "pnpm quality:check && pnpm -r --filter \"./packages/*\" check && pnpm release:check",
    "clean": "node scripts/clean.mjs",
    "quality:check": "node scripts/quality-check.mjs",
    "release:check": "node --test scripts/release-policy.test.mjs",
    "pack:dry": "node scripts/check-packable.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "rollup": "^4.29.1",
    "svgo": "^3.3.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vue": "^3.5.13"
  }
}
