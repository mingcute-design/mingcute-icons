{
  "name": "@mingcute/icons",
  "version": "3.0.1",
  "description": "Framework-neutral Mingcute icon definitions for Core Regular and Filled.",
  "keywords": [
    "icons",
    "svg-icons",
    "vector-icons",
    "icon-library",
    "svg",
    "icon-data",
    "mingcute"
  ],
  "license": "Apache-2.0",
  "author": "MingCute Design",
  "homepage": "https://www.mingcute.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mingcute-design/mingcute-icons.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/mingcute-design/mingcute-icons/issues"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.json": "./dist/styles.json",
    "./metadata/*": "./dist/styles/*/metadata.json",
    "./core-regular": {
      "types": "./dist/styles/core-regular.d.ts",
      "import": "./dist/styles/core-regular.js"
    },
    "./core-regular/*": {
      "types": "./dist/styles/core-regular/*.d.ts",
      "import": "./dist/styles/core-regular/*.js"
    },
    "./core-filled": {
      "types": "./dist/styles/core-filled.d.ts",
      "import": "./dist/styles/core-filled.js"
    },
    "./core-filled/*": {
      "types": "./dist/styles/core-filled/*.d.ts",
      "import": "./dist/styles/core-filled/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:runtime": "tsc -p tsconfig.json",
    "build": "pnpm run clean && pnpm run build:runtime && node scripts/build-package.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "audit:pack": "node scripts/audit-pack.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run audit:pack",
    "clean": "node ../../scripts/clean-package.mjs dist"
  },
  "devDependencies": {
    "@mingcute/compiler": "workspace:*",
    "@mingcute/core": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "sideEffects": false
}
