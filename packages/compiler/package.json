{
  "name": "@mingcute/compiler",
  "version": "3.0.1",
  "description": "Framework-neutral SVG compiler for Mingcute icon definitions.",
  "license": "Apache-2.0",
  "author": "MingCute Design",
  "homepage": "https://www.mingcute.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mingcute-design/mingcute-icons.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/mingcute-design/mingcute-icons/issues"
  },
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "audit:assets": "pnpm run build && node scripts/audit-assets.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run audit:assets",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mingcute/core": "workspace:*",
    "saxes": "^6.0.0",
    "svgo": "^3.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "sideEffects": false,
  "keywords": [
    "svg-icons",
    "vector-icons",
    "icon-library"
  ]
}
