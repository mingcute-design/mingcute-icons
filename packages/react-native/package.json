{
  "name": "@mingcute/react-native",
  "version": "3.0.2",
  "description": "Mingcute icon components for React Native.",
  "keywords": [
    "icons",
    "svg-icons",
    "vector-icons",
    "icon-library",
    "react-native",
    "react-native-svg",
    "mingcute"
  ],
  "license": "Apache-2.0",
  "author": "MingCute Design",
  "homepage": "https://www.mingcute.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mingcute-design/mingcute-icons.git",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/mingcute-design/mingcute-icons/issues"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core-regular": {
      "types": "./dist/styles/core-regular.d.ts",
      "import": "./dist/styles/core-regular.js"
    },
    "./core-regular/*": {
      "types": "./dist/styles/core-regular/*.d.ts",
      "import": "./dist/styles/core-regular/*.js"
    },
    "./core-filled": {
      "types": "./dist/styles/core-filled.d.ts",
      "import": "./dist/styles/core-filled.js"
    },
    "./core-filled/*": {
      "types": "./dist/styles/core-filled/*.d.ts",
      "import": "./dist/styles/core-filled/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:tooling": "tsc -p tsconfig.tooling.json",
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "build": "pnpm run clean && pnpm run build:tooling && pnpm run build:runtime && node scripts/build-package.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "typecheck:device": "tsc -p tsconfig.device.json",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "audit:pack": "node scripts/audit-pack.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run typecheck:device && pnpm run audit:pack",
    "clean": "node ../../scripts/clean-package.mjs dist .tooling"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-svg": ">=13"
  },
  "dependencies": {
    "@mingcute/icons": "workspace:*"
  },
  "devDependencies": {
    "@mingcute/compiler": "workspace:*",
    "@mingcute/core": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "esbuild": "^0.27.3",
    "react": "^19.0.0",
    "react-native": "^0.86.0",
    "react-native-svg": "^15.15.5",
    "react-test-renderer": "^19.0.0",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "sideEffects": false
}
