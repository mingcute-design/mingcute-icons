{
  "name": "@mingcute/svelte",
  "version": "3.0.2",
  "description": "Mingcute SVG icon components for Svelte.",
  "keywords": [
    "icons",
    "svg-icons",
    "vector-icons",
    "icon-library",
    "svg",
    "svelte",
    "mingcute"
  ],
  "license": "Apache-2.0",
  "author": "MingCute Design",
  "homepage": "https://www.mingcute.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mingcute-design/mingcute-icons.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/mingcute-design/mingcute-icons/issues"
  },
  "private": false,
  "type": "module",
  "svelte": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./core-regular": {
      "types": "./dist/styles/core-regular.d.ts",
      "svelte": "./dist/styles/core-regular.js",
      "import": "./dist/styles/core-regular.js"
    },
    "./core-regular/*": {
      "types": "./dist/styles/core-regular/*.d.ts",
      "svelte": "./dist/styles/core-regular/*.svelte",
      "import": "./dist/styles/core-regular/*.svelte"
    },
    "./core-filled": {
      "types": "./dist/styles/core-filled.d.ts",
      "svelte": "./dist/styles/core-filled.js",
      "import": "./dist/styles/core-filled.js"
    },
    "./core-filled/*": {
      "types": "./dist/styles/core-filled/*.d.ts",
      "svelte": "./dist/styles/core-filled/*.svelte",
      "import": "./dist/styles/core-filled/*.svelte"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:tooling": "tsc -p tsconfig.tooling.json",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build": "pnpm run clean && pnpm run build:tooling && pnpm run build:runtime && node scripts/build-package.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "typecheck:contract": "tsc -p tsconfig.contract.json",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "audit:pack": "node scripts/audit-pack.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run typecheck:contract && pnpm run audit:pack",
    "clean": "node ../../scripts/clean-package.mjs dist .tooling"
  },
  "peerDependencies": {
    "svelte": ">=5.20.0"
  },
  "dependencies": {
    "@mingcute/icons": "workspace:*"
  },
  "devDependencies": {
    "@mingcute/compiler": "workspace:*",
    "@mingcute/core": "workspace:*",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.55.9",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "sideEffects": false
}
